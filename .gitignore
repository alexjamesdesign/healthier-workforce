# Ignore node_modules, dist folder and composer
wp-content/themes/THEME-NAME/node_modules/*
wp-content/themes/THEME-NAME/vendor/*
wp-content/themes/THEME-NAME/dist/*

##### DO NOT EDIT BELOW THIS LINE #####

# Ignore the config
wp-config.php

# Ignore the uploads and any backups from AllInOne WP Migration 'cause it's massive
wp-content/uploads/*
wp-content/ai1wm-backups/*

# ignore all files starting with . or ~
.*
~*
# Don't ignore the gitignore or htaccess #
!.gitignore
!.htaccess
!.env.ald
!.github

# ignore OS generated files
ehthumbs.db
Thumbs.db

# ignore Editor files
*.sublime-project
*.sublime-workspace
*.komodoproject

# ignore log files and databases
*.log
*.sql
*.sqlite

