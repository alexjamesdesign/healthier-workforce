##### Edit Below This Line #####

# Ignore node_modules, dist folder and composer
wp-content/themes/healthier-workforce/node_modules/*
wp-content/themes/healthier-workforce/vendor/*
wp-content/themes/healthier-workforce/dist/*

##### DO NOT EDIT BELOW THIS LINE #####

# Ignore the config
wp-config.php

# Ignore the uploads and any backups from AllInOne WP Migration 'cause it's massive
wp-content/uploads/*
wp-content/ai1wm-backups/*

# ignore all files starting with . or ~
.*
~*
# Don't ignore the gitignore or htaccess #
!.gitignore
!.htaccess
!.env.ald
!.github

# ignore OS generated files
.DS_Store
ehthumbs.db
Thumbs.db

# ignore local tool config and logs
prepros-6.config
error_log

# ignore Editor files
*.sublime-project
*.sublime-workspace
*.komodoproject

# ignore log files and databases
*.log
*.sql
*.sqlite

# ignore wp-config 
wp-config.php
# ignore compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# ignore packaged files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip
